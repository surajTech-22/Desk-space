  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <None Include="Install-DeskTouch.ps1" CopyToOutputDirectory="PreserveNewest" />
